NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=chrome-extension://*

# PostgreSQL (Phase 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/notion_highlight_dev

# Session secret (Phase 2) — must be at least 32 chars
SESSION_SECRET=replace-this-with-a-random-32-char-secret

# Notion API Prototype (Phase 1)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Notion OAuth (Phase 4)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3001/api/notion/callback

